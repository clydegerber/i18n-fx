    <name>i18n-fx</name>
    <description>JavaFX bindings for the i18n-core internationalization framework, providing locale-aware JavaFX components that automatically update their properties when the application locale changes.</description>
    <url>https://github.com/clydegerber/i18n-fx</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Clyde Gerber</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/clydegerber/i18n-fx.git</connection>
        <developerConnection>scm:git:https://github.com/clydegerber/i18n-fx.git</developerConnection>
        <url>https://github.com/clydegerber/i18n-fx</url>
