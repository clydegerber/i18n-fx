        <!-- Test profiles -->
        <profile>
            <id>test-classpath</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <argLine>-Dprism.order=sw</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>test-modulepath</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <!-- Create a shell script that runs the tests -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>create-test-script</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <!-- Build the full module path -->
                                        <loadfile property="dep.classpath" srcFile="${project.build.directory}/modulepath.txt"/>
                                        <property name="full.modulepath" value="${project.build.testOutputDirectory}:${project.build.outputDirectory}:${dep.classpath}"/>

                                        <!-- Create shell script -->
                                        <echo file="${project.build.directory}/run-module-tests.sh">#!/bin/sh
java --module-path "${full.modulepath}" --add-modules ALL-MODULE-PATH -Dprism.order=sw -m org.junit.platform.console --select-module dev.javai18n.fx.test
</echo>
                                        <chmod file="${project.build.directory}/run-module-tests.sh" perm="755"/>

                                        <!-- Run the script -->
                                        <exec executable="${project.build.directory}/run-module-tests.sh" failonerror="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>run-demo</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>run-demo-app</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <loadfile property="dep.classpath" srcFile="${project.build.directory}/modulepath.txt"/>
                                        <property name="full.modulepath" value="${project.build.testOutputDirectory}:${project.build.outputDirectory}:${dep.classpath}"/>
                                        <exec executable="java" failonerror="true">
                                            <arg value="--module-path"/>
                                            <arg value="${full.modulepath}"/>
                                            <arg value="--add-modules"/>
                                            <arg value="ALL-MODULE-PATH"/>
                                            <arg value="-m"/>
                                            <arg value="dev.javai18n.fx.test/dev.javai18n.fx.test.TestFXApp"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jpackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <loadfile property="dep.classpath" srcFile="${project.build.directory}/modulepath.txt"/>
                                        <property name="full.modulepath" value="${project.build.testOutputDirectory}:${project.build.outputDirectory}:${dep.classpath}"/>
                                        <!-- The mounted volume acquires com.apple.FinderInfo xattrs on every
                                             new directory, which codesign rejects.  Build in /private/tmp
                                             (system volume, not Spotlight-indexed) where codesign succeeds,
                                             then copy the signed app back to target/dist/. -->
                                        <property name="jpackage.tmp" value="/private/tmp/i18n-fx-jpackage"/>
                                        <delete dir="${jpackage.tmp}" quiet="true"/>
                                        <mkdir dir="${jpackage.tmp}"/>
                                        <exec executable="${java.home}/bin/jpackage" failonerror="true">
                                            <arg value="--name"/>
                                            <arg value="File Explorer FX"/>
                                            <arg value="--app-version"/>
                                            <arg value="1.0"/>
                                            <arg value="--vendor"/>
                                            <arg value="Clyde Gerber"/>
                                            <arg value="--type"/>
                                            <arg value="app-image"/>
                                            <arg value="--module-path"/>
                                            <arg value="${full.modulepath}"/>
                                            <arg value="--module"/>
                                            <arg value="dev.javai18n.fx.test/dev.javai18n.fx.test.TestFXApp"/>
                                            <arg value="--add-modules"/>
                                            <arg value="jdk.localedata"/>
                                            <arg value="--java-options"/>
                                            <arg value="--enable-native-access=javafx.graphics"/>
                                            <arg value="--java-options"/>
                                            <arg value="-Dsun.misc.unsafe.memory.access=allow"/>
                                            <arg value="--icon"/>
                                            <arg value="${project.build.testOutputDirectory}/dev/javai18n/fx/test/app-icon.icns"/>
                                            <arg value="--dest"/>
                                            <arg value="${jpackage.tmp}"/>
                                        </exec>
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                        <mkdir dir="${project.build.directory}/dist"/>
                                        <exec executable="ditto" failonerror="true">
                                            <arg value="${jpackage.tmp}/File Explorer FX.app"/>
                                            <arg value="${project.build.directory}/dist/File Explorer FX.app"/>
                                        </exec>
                                        <delete dir="${jpackage.tmp}" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>all</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>add-readme-to-javadoc-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <jar destfile="${project.build.directory}/${project.artifactId}-${project.version}-javadoc.jar" update="true">
                                            <fileset dir="${project.build.directory}/html" includes="README.html"/>
                                        </jar>
                                        <copy file="${project.build.directory}/html/README.html"
                                              todir="${project.build.directory}/reports/apidocs"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
